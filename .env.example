# Usaha Qita — powered by BRI
# Environment Variables Template (Zero Secret)
# Salin file ini menjadi .env.local untuk konfigurasi lingkungan lokal jika diperlukan.
# PERINGATAN: Jangan pernah menuliskan API key atau kredensial rahasia ke dalam repository ini!

# Mode Aplikasi
NODE_ENV=development

# Port Server Lokal (Bawaan: 3000)
PORT=3000

# Batas Integrasi Masa Depan (Post-MVP / Fase Lanjutan - Kosongkan pada tahap MVP)
# NEXT_PUBLIC_GEMINI_API_KEY=
# NEXT_PUBLIC_GOOGLE_PLACES_KEY=

